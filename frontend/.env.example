# Development only: where the Vite dev server forwards /api requests.
# The Jira credentials are NOT configured here; they live in backend/.env.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional: call a backend on another origin directly (needs FRONTEND_ORIGINS on the backend).
# Leave empty to use the same-origin /api proxy.
VITE_API_BASE_URL=

# ---------------------------------------------------------------
# Auto Project backend configuration. Copy to ".env" and fill in
# the three Jira values. Never commit ".env".
# ---------------------------------------------------------------

# Required: your Jira Cloud credentials
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token

# Projects to show (comma separated Jira project keys)
JIRA_PROJECT_KEYS=TDF,BE

# ---- Optional technical settings (defaults shown) ----
# development | production  (production hides /docs and requires https Jira URL)
APP_ENV=development
LOG_LEVEL=INFO
# Comma separated browser origins allowed to call this API directly.
# Not needed when the frontend proxies /api (default setup).
FRONTEND_ORIGINS=http://localhost:5173
# How long project statistics / issue lists are cached (0 disables caching)
CACHE_TTL_SECONDS=60
JIRA_TIMEOUT_SECONDS=20
JIRA_MAX_RETRIES=3
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
